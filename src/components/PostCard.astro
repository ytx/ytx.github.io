---
import { Image } from "astro:assets";
import { categoryName, getCategory } from "../data/categories";
import { formatDate, t, type Lang } from "../i18n";
import { postUrl } from "../lib/urls";
import type { Post } from "../lib/posts-core";

interface Props {
  lang: Lang;
  post: Post;
}
const { lang, post } = Astro.props;
const { data, slug, category, translated } = post;
const path = category.child ? `${category.parent}/${category.child}` : category.parent;
const badge = category.child
  ? `${categoryName(category.parent, lang)} / ${categoryName(category.child, lang)}`
  : categoryName(category.parent, lang);
const color = getCategory(category.parent)?.color ?? "var(--hero-bg)";
const untranslated = !translated && lang !== "ja";
---
<a class="post-card" href={postUrl(lang, path, slug)} data-category={category.parent}>
  <div class="thumb" style={data.thumbnail ? undefined : `background:${color}`}>
    {data.thumbnail && <Image src={data.thumbnail} alt="" width={640} height={360} />}
  </div>
  <div class="body">
    <div class="badges">
      <span class="badge badge-category" style={`background:${color}`}>{badge}</span>
      {untranslated && <span class="badge badge-untranslated">{t(lang, "untranslated.badge")}</span>}
    </div>
    <h3>{data.title}</h3>
    <p>{data.description}</p>
    <time datetime={data.published.toISOString()}>{formatDate(data.published, lang)}</time>
  </div>
</a>
<style>
  .post-card {
    display: block;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    color: var(--text);
    text-decoration: none;
    transition: transform 0.2s ease;
  }
  .post-card:hover {
    transform: translateY(-2px);
  }
  .thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    padding: 16px 18px 20px;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
  }
  .badge {
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    color: var(--text);
    background: var(--hero-bg);
  }
  .badge-untranslated {
    color: var(--text-muted);
  }
  h3 {
    margin: 0 0 6px;
    font-size: 1.05rem;
  }
  p {
    margin: 0 0 10px;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  time {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
