---
import { t, type Lang } from "../i18n";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const now = new Date().getFullYear();
const year = now <= 2025 ? "2025" : `2025-${now}`;
const copyright = t(lang, "footer.copyright").replace("2025-{year}", year);
---
<footer class="site-footer">
  <div class="container">
    <small>{copyright}</small>
  </div>
</footer>
<style>
  .site-footer {
    margin-top: 64px;
    padding: 24px 0 32px;
    color: var(--text-muted);
    text-align: center;
  }
</style>
