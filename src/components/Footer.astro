---
import { t, type Lang } from "../i18n";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<footer class="site-footer">
  <div class="container">
    <small>{t(lang, "footer.copyright")}</small>
  </div>
</footer>
<style>
  .site-footer {
    margin-top: 64px;
    padding: 24px 0 32px;
    color: var(--text-muted);
    text-align: center;
  }
</style>
