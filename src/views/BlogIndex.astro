---
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import CategoryTree from "../components/CategoryTree.astro";
import PostCard from "../components/PostCard.astro";
import { t, otherLang, type Lang } from "../i18n";
import { blogUrl } from "../lib/urls";
import { getPosts } from "../lib/posts";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const posts = await getPosts(lang);
---
<Base lang={lang} title={t(lang, "blog.title")} description={t(lang, "blog.sub")} alternate={blogUrl(otherLang(lang))}>
  <div class="container">
    <SectionHead title={t(lang, "blog.title")} sub={t(lang, "blog.sub")} />
    <CategoryTree lang={lang} />
    <div class="grid list">
      {posts.map((post) => <PostCard lang={lang} post={post} />)}
    </div>
  </div>
</Base>
<style>
  .list {
    margin-top: 28px;
  }
</style>
