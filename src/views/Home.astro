---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SectionHead from "../components/SectionHead.astro";
import WorkCard from "../components/WorkCard.astro";
import CategoryPills from "../components/CategoryPills.astro";
import { t, otherLang, type Lang } from "../i18n";
import { blogUrl, homeUrl, worksUrl } from "../lib/urls";
import { getFeaturedWorks, getWorks } from "../lib/works";
import { getPosts, latestPerParent } from "../lib/posts";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const featured = await getFeaturedWorks(lang);
const works = (await getWorks(lang)).slice(0, 8);
const posts = await getPosts(lang);
---
<Base lang={lang} title={t(lang, "siteName")} alternate={homeUrl(otherLang(lang))}>
  <div class="container">
    <h1 class="visually-hidden" style="position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0">{t(lang, "siteName")}</h1>
    <Hero lang={lang} works={featured} />
    <SectionHead title={t(lang, "works.title")} sub={t(lang, "works.sub")} moreHref={worksUrl(lang)} moreLabel={t(lang, "works.all")} />
    <div class="grid">
      {works.map((work) => <WorkCard lang={lang} work={work} />)}
    </div>
    <SectionHead title={t(lang, "blog.title")} sub={t(lang, "blog.sub")} moreHref={blogUrl(lang)} moreLabel={t(lang, "blog.all")} />
    <CategoryPills lang={lang} groups={latestPerParent(posts, 6)} all={posts.slice(0, 6)} />
  </div>
</Base>
