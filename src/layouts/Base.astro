---
import { Font } from "astro:assets";
import "../styles/global.css";
import { otherLang, t, type Lang } from "../i18n";
import { homeUrl, rssUrl } from "../lib/urls";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  alternate?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  htmlLang?: Lang;
}
const { lang, title, description, alternate = homeUrl(otherLang(lang)), htmlLang = lang, ogImage, ogType = "website" } = Astro.props;
const site = Astro.site ?? new URL("https://ytx.github.io");
const here = Astro.url.pathname;
const jaPath = lang === "ja" ? here : alternate;
const enPath = lang === "en" ? here : alternate;
const jaHref = new URL(jaPath, site).href;
const enHref = new URL(enPath, site).href;
const pageTitle = title === t(lang, "siteName") ? title : `${title} | ytx`;
const ogUrl = new URL(here, site).href;
const ogImageUrl = new URL(ogImage ?? "/og-default.png", site).href;
---
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === "ja" ? "ja_JP" : "en_US"} />
    <meta property="og:site_name" content="ytx" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="ja" href={jaHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={jaHref} />
    <link rel="alternate" type="application/rss+xml" href={rssUrl(lang)} />
    <Font cssVariable="--font-zen-maru" preload />
  </head>
  <body>
    <Header lang={lang} alternate={alternate} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
